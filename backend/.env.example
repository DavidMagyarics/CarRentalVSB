# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# JWT signing key for auth tokens. Any random string; changing it logs
# everyone out. Required for a real deployment, optional for local dev
# (falls back to a fixed dev-only value).
SECRET_KEY=change-me-in-production

# Email notifications (optional). If SMTP_HOST is not set, reservation
# confirmations are only logged to the console instead of actually sent.
#
# Example for Gmail:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an "App password": https://myaccount.google.com/apppasswords
#   3. Use that 16-character app password below (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-address@gmail.com
