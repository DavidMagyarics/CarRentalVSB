@startuml container-v1
skinparam backgroundColor white

package "Prohlížeč" {
  component "Frontend SPA\nReact + TypeScript (Vite)" as spa
}

package "Backend server" {
  component "REST API\nPython / FastAPI" as api
  database "Databáze\nSQLite (dev) / PostgreSQL (prod)" as db
}

spa --> api : HTTP/JSON (fetch)
api --> db : SQLAlchemy ORM
@enduml
