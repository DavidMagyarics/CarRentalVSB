@startuml sequence-confirm-reservation
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — Confirm reservation (UC8)
actor Admin
boundary ":WebApp" as Web
control ":ReservationService" as Res
control ":AuthService" as Auth
database ":Database" as DB
control ":NotificationService" as NS

Admin -> Web : confirmReservation(id)
Web -> Res : confirm_reservation(token, id)\n[POST /reservations/{id}/confirm]
Res -> Auth : require_admin(token)

alt not an admin
  Auth --> Res : 403
  Res --> Web : 403 "Vyžadována jsou práva administrátora"
else admin
  Auth --> Res : admin : User
  Res -> DB : query(Reservation, id)
  DB --> Res : r (404 if none)

  alt r.status ≠ DRAFT
    Res --> Web : 409 "Rezervaci ve stavu ... nelze potvrdit"
  else r is still DRAFT
    Res -> Res : is_car_available(r.car, r.start_date, r.end_date)
    ref over Res, DB : UC4a Check availability
    alt slot taken in the meantime
      Res --> Web : 409 "Auto je v tomto termínu\nuž jinou rezervací potvrzeno"
    else car still available
      Res -> DB : save(r) with r.status = CONFIRMED
      Res -> NS : send_confirmation(r, r.user)
      ref over NS : UC8a Send notification
      NS --> Res : true / false\n(a failure is only logged)
      Res --> Web : 200 OK r
      Web -> Web : reload all reservations (UC10)
    end
  end
end

Web --> Admin : reservation confirmed, or error message

note over Res, DB
  No transactional locking: two confirmations at the
  same moment could both pass the re-check
  (known risk, see intent-and-change.md).
end note
@enduml
