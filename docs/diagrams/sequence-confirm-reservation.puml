@startuml sequence-confirm-reservation
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — Confirm reservation (UC8)
actor Admin
participant ":ReservationService" as Res
participant "admin : User" as A
participant "r : Reservation" as R
participant ":NotificationService" as NS

Admin -> Res : confirm_reservation(id)\n[POST /reservations/{id}/confirm]
Res -> A : is_admin()
A --> Res : true / false

alt not an admin
  Res --> Admin : 403 "Vyžadována jsou práva administrátora"
else admin
  Res -> Res : get_reservation(id)
  Res -> R : get_status()
  R --> Res : status
  alt status ≠ DRAFT
    Res --> Admin : 409 "Rezervaci ve stavu ... nelze potvrdit"
  else DRAFT
    Res -> Res : is_car_available(r.car, r.start_date, r.end_date)
    ref over Res, R : UC4a Check availability
    alt slot taken in the meantime
      Res --> Admin : 409 "Auto je v tomto termínu\nuž jinou rezervací potvrzeno"
    else car still available
      Res -> R : confirm()
      R -> R : status = CONFIRMED
      Res -> NS : send_confirmation(r, r.user)
      ref over NS : UC8a Send notification
      NS --> Res : true / false (a failure is only logged)
      Res --> Admin : 200 OK r
    end
  end
end

note over Res, R
  No locking: two confirmations at the same
  moment could both pass the re-check
  (known risk, see intent-and-change.md).
end note
@enduml
