@startuml sequence-cancel-reservation
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
hide footbox
title Sequence — Cancel reservation (UC5)

actor "User\n(Customer or Admin)" as User
box "Frontend (React)" #E3F2FD
  participant ":App" as App
  participant ":ReservationList\n(admin: :AdminReservations)" as List
  participant ":Toast" as Toast
  participant ":ApiClient" as ApiClient
end box
box "REST API (FastAPI)" #FFF3E0
  participant ":ReservationsRouter" as ResRouter
  participant ":Deps" as Deps
end box
box "Services" #E8F5E9
  participant ":ReservationService" as ResService
end box
box "Persistence" #F3E5F5
  participant "db : Session" as DB
  participant "r : Reservation" as R
end box

User -> List : click "Zrušit" on a reservation
List -> List : handleCancel(id)\n(admin: act(id, cancelReservation, ...))
List -> ApiClient : cancelReservation(token, id)
ApiClient -> ResRouter : cancel_reservation(id)\n[HTTP POST /reservations/{id}/cancel + JWT]
ResRouter -> Deps : get_current_user(token)
Deps --> ResRouter : current_user : User (401 if the token is invalid)
ResRouter -> ResService : get_reservation(id)
ResService -> DB : query(Reservation).filter(id).first()
DB --> ResService : r
ResService --> ResRouter : r (404 if None)
ResRouter -> ResRouter : _ensure_owner_or_admin(r, current_user)

alt not the owner and not an admin
  ResRouter --> ApiClient : 403 Forbidden\n"Tato rezervace vám nepatří"
  ApiClient --> List : throw Error(detail)
  List -> Toast : show(detail, "error")
else owner or admin
  ResRouter -> ResService : cancel_reservation(id)
  ResService -> ResService : get_reservation(id)
  ResService -> R : read status, start_date
  R --> ResService : status, start_date

  alt status == CANCELLED
    ResService --> ResRouter : raise DomainError\n"Rezervace je již zrušena"
    ResRouter --> ApiClient : 409 Conflict
    ApiClient --> List : throw Error(detail)
    List -> Toast : show(detail, "error")
  else status == CONFIRMED and start_date <= now
    ResService --> ResRouter : raise DomainError\n"Potvrzenou rezervaci nelze zrušit poté,\nco již začal termín výpůjčky"
    ResRouter --> ApiClient : 409 Conflict
    ApiClient --> List : throw Error(detail)
    List -> Toast : show(detail, "error")
  else can be cancelled
    ResService -> R : status = CANCELLED
    ResService -> DB : commit(), refresh(r)
    ResService --> ResRouter : r
    ResRouter --> ApiClient : 200 OK {reservation}
    ApiClient --> List : Reservation
    List -> Toast : show("Rezervace byla zrušena.", "success")
    List -> App : onChanged() → loadMyReservations()\n(admin: loadAllReservations())
    ref over App, DB : UC6 View my reservations / UC10 View all reservations
  end
end

List --> User : see result\n(cancelled, or error message)
@enduml
