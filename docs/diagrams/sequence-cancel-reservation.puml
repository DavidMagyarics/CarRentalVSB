@startuml sequence-cancel-reservation
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — Cancel reservation (UC5)
actor "User\n(Customer or Admin)" as User
participant ":ReservationService" as Res
participant "u : User" as U
participant "r : Reservation" as R

User -> Res : cancel_reservation(id)\n[POST /reservations/{id}/cancel]
Res -> Res : get_reservation(id)
note right of Res
  r : Reservation (404 if it does not exist);
  u is the logged-in user (see UC6)
end note
Res -> R : get_user()
R --> Res : owner
Res -> U : is_admin()
U --> Res : true / false

alt u is not the owner and not an admin
  Res --> User : 403 "Tato rezervace vám nepatří"
else owner or admin
  Res -> R : cancel()
  alt already CANCELLED
    R --> Res : error
    Res --> User : 409 "Rezervace je již zrušena"
  else CONFIRMED and the rental has already started
    R --> Res : error
    Res --> User : 409 "Potvrzenou rezervaci nelze zrušit\npoté, co již začal termín výpůjčky"
  else
    R -> R : status = CANCELLED
    R --> Res : ok
    Res --> User : 200 OK r — the slot is free again
  end
end
@enduml
