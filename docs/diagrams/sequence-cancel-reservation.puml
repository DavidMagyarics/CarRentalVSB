@startuml sequence-cancel-reservation
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — Cancel reservation (UC5)
actor "User\n(Customer or Admin)" as User
boundary ":WebApp" as Web
control ":ReservationService" as Res
control ":AuthService" as Auth
database ":Database" as DB
entity "r : Reservation" as R

User -> Web : cancelReservation(id)
Web -> Res : cancel_reservation(token, id)\n[POST /reservations/{id}/cancel]
Res -> Auth : get_current_user(token)
Auth --> Res : user : User
Res -> DB : query(Reservation, id)
DB --> Res : r (404 if none)
Res -> R : get owner, status, start_date
R --> Res : values

alt r is not the user's and the user is not an admin
  Res --> Web : 403 "Tato rezervace vám nepatří"
else r.status = CANCELLED
  Res --> Web : 409 "Rezervace je již zrušena"
else r.status = CONFIRMED and r.start_date has passed
  Res --> Web : 409 "Potvrzenou rezervaci nelze zrušit\npoté, co již začal termín výpůjčky"
else can be cancelled
  Res -> R : status = CANCELLED
  Res -> DB : save(r)
  Res --> Web : 200 OK r
  Web -> Web : reload the list (UC6 / UC10)
end

Web --> User : reservation cancelled, or error message
@enduml
