@startuml use-case
left to right direction
skinparam backgroundColor white

actor "Customer" as Customer
actor "Admin" as Admin

usecase "Register" as UC1
usecase "Log in" as UC2
usecase "Browse & filter cars" as UC3
usecase "Create reservation" as UC4
usecase "Check availability" as UC4a
usecase "Cancel reservation" as UC5
usecase "View my reservations" as UC6
usecase "Contact support" as UC7
usecase "Confirm reservation" as UC8
usecase "Send notification" as UC8a
usecase "Manage fleet" as UC9
usecase "View all reservations" as UC10

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4
Customer --> UC5
Customer --> UC6
Customer --> UC7

Admin --> UC2
Admin --> UC5
Admin --> UC8
Admin --> UC9
Admin --> UC10

UC4 ..> UC4a : <<include>>
UC8 ..> UC4a : <<include>>
UC8 ..> UC8a : <<include>>
@enduml
