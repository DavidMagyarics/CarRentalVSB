@startuml use-case
left to right direction
skinparam backgroundColor white

actor "Customer" as Customer
actor "Admin" as Admin

usecase "Browse car offers" as UC1
usecase "Create reservation" as UC2
usecase "Confirm reservation" as UC3
usecase "Cancel reservation" as UC8
usecase "Register / log in" as UC4
usecase "Manage fleet" as UC5
usecase "Manage reservations" as UC6
usecase "Check car availability" as UC7
usecase "Send notification" as UC9

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC8
Customer --> UC4

Admin --> UC5
Admin --> UC6
Admin --> UC4

UC2 ..> UC7 : <<include>>
UC3 ..> UC7 : <<include>>
UC3 ..> UC9 : <<include>>
@enduml
