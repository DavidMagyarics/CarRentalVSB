@startuml sequence-browse-cars
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — Browse & filter cars (UC3)
actor Customer
participant ":FleetService" as Fleet
participant "c : Car" as C
participant "b : Branch" as B

Customer -> Fleet : get_cars(filters)\n[GET /cars/?category=...&branch_id=...]
note right of Fleet
  No filter set = every car.
  The filters are category, transmission,
  fuel type, price range and branch.
end note
loop for each car of the fleet
  Fleet -> C : matches(filters)
  C --> Fleet : true / false
  opt matches
    C -> B : get_name()
    B --> C : branch name
  end
end

alt no car matches
  Fleet --> Customer : [] — "Žádná auta neodpovídají\nzvoleným filtrům."
else
  Fleet --> Customer : Car[] — photo, branch,\nprice per day and per hour
end
@enduml
