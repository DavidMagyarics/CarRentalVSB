@startuml class-system
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80
skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #555555
}
title Class diagram — CarRentalVSB

class AuthService {
  + create_user(name, email, password) : Token
  + authenticate_user(email, password) : Token
  + get_current_user(token) : User
  - get_user_by_email(email) : User
  - hash_password(password) : str
  - create_access_token(user) : JWT
}

class ReservationService {
  + create_reservation(car, start, end, payment) : Reservation
  + is_car_available(car, start, end) : bool
  + confirm_reservation(id) : Reservation
  + cancel_reservation(id) : Reservation
  + get_reservations_for_user() : Reservation[]
  + get_reservations() : Reservation[]
  - get_reservation(id) : Reservation
  - calculate_price(car, start, end) : float
}

class FleetService {
  + get_cars(filters) : Car[]
  + create_car(data) : Car
  + update_car(id, data) : Car
  + delete_car(id)
  - get_car(id) : Car
  - get_branch(id) : Branch
}

interface NotificationService {
  + send_confirmation(reservation, user) : bool
}
class EmailNotificationService {
  + send_confirmation(reservation, user) : bool
}
class LoggingNotificationService {
  + send_confirmation(reservation, user) : bool
}

class SupportWidget {
  + open()
  + close()
}

class User {
  id : int
  name : str
  email : str
  password_hash : str
  role : CUSTOMER | ADMIN
  + check_password(password) : bool
  + is_admin() : bool
  + get_reservations() : Reservation[]
}

class Reservation {
  id : int
  start_date : datetime
  end_date : datetime
  status : DRAFT | CONFIRMED | CANCELLED
  total_price : float
  payment_method : CASH | CARD
  + get_status() : Status
  + get_user() : User
  + get_car() : Car
  + overlaps(start, end) : bool
  + confirm()
  + cancel()
}

class Car {
  id : int
  brand : str
  model : str
  license_plate : str
  daily_price : float
  hourly_price : float
  category, transmission, fuel_type
  + get_prices() : (float, float)
  + matches(filters) : bool
  + update(data)
}

class Branch {
  id : int
  name : str
  address : str
  + get_name() : str
}

ReservationService -left-> AuthService : token
ReservationService -right-> NotificationService : on confirm
NotificationService <|.. EmailNotificationService
NotificationService <|.. LoggingNotificationService

AuthService ...> User : <<instantiate>>
ReservationService ...> Reservation : <<instantiate>>
FleetService ...> Car : <<instantiate>>

' every message in a sequence diagram needs a link between the two classes
ReservationService ...> Car : get_prices
ReservationService ...> User : is_admin
FleetService ...> User : is_admin
FleetService ...> Branch : get_branch

User "1" -right- "0..*" Reservation : creates >
Reservation "0..*" -right- "1" Car : for >
Car "0..*" -right- "1" Branch : located at >
@enduml
