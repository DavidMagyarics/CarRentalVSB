@startuml class-system
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60
skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #555555
}
title Class diagram — CarRentalVSB

package "Frontend (React)" {
  class ApiClient <<api.ts>> {
    + login(email, password)
    + register(name, email, password)
    + fetchCars(filters)
    + checkAvailability(carId, start, end)
    + createReservation(car, start, end, payment)
    + cancelReservation(id)
    + confirmReservation(id)
    + createCar(car) / updateCar / deleteCar
  }
}

package "REST API (FastAPI routers)" {
  class AuthRouter <<routers/auth.py>> {
    POST /auth/register
    POST /auth/login
  }
  class ReservationsRouter <<routers/reservations.py>> {
    POST /reservations/
    GET /reservations/me
    GET /reservations/  (admin)
    POST /reservations/{id}/confirm  (admin)
    POST /reservations/{id}/cancel
  }
  class CarsRouter <<routers/cars.py + branches.py>> {
    GET /cars/ , GET /branches/
    GET /cars/{id}/availability
    POST · PUT · DELETE /cars/  (admin)
  }
}

package "Services (business logic)" {
  class AuthService <<auth.py + crud.py>> {
    + register(name, email, password) : User
    + authenticate(email, password) : User
    - hash_password(password)
    + create_access_token(user) : JWT
  }
  class ReservationService <<crud.py>> {
    + create_reservation(user, car, start, end) : Reservation
    + is_car_available(car, start, end) : bool
    + calculate_price(car, start, end) : float
    + confirm_reservation(id) : Reservation
    + cancel_reservation(id) : Reservation
  }
  interface NotificationService <<notification.py>> {
    + send_confirmation(reservation, user) : bool
  }
  class LoggingNotificationService {
    default: writes to the log
  }
  class EmailNotificationService {
    used when SMTP is configured
  }
  class FleetService <<crud.py>> {
    + get_cars(filters) : Car[]
    + create_car(car) / update_car / delete_car
    + delete_branch(id)
  }
}

package "Domain model (database tables)" {
  class User {
    id : int
    name : str
    email : str
    password_hash : str
    role : CUSTOMER | ADMIN
  }
  class Reservation {
    id : int
    start_date : datetime
    end_date : datetime
    status : DRAFT | CONFIRMED | CANCELLED
    total_price : float
    payment_method : CASH | CARD
  }
  class Car {
    id : int
    brand : str
    model : str
    year : int
    license_plate : str
    daily_price : float
    hourly_price : float
    category, transmission, fuel_type
  }
  class Branch {
    id : int
    name : str
    address : str
  }
}


ApiClient -down-> AuthRouter : HTTP
ApiClient -down-> ReservationsRouter : HTTP
ApiClient -down-> CarsRouter : HTTP

AuthRouter -down-> AuthService
ReservationsRouter -down-> ReservationService
ReservationsRouter -down-> NotificationService : on confirm
CarsRouter -down-> FleetService

NotificationService <|.down. LoggingNotificationService
NotificationService <|.down. EmailNotificationService

AuthService -down---> User
ReservationService -down---> Reservation
FleetService -down---> Car

User "1" -- "0..*" Reservation : creates >
Reservation "0..*" -- "1" Car : for >
Car "0..*" -- "1" Branch : located at >
@enduml
