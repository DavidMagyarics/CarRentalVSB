@startuml class-system
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80
skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #555555
}
title Class diagram — CarRentalVSB

class WebApp <<boundary>> {
  token : string
  user : User
  + register(name, email, password)
  + login(email, password)
  + showCars(filters)
  + reserveCar(car)
  + showReservations()
  + cancelReservation(id)
  + confirmReservation(id)
  + saveCar(data)
  + deleteCar(id)
  + openSupport()
  - isWithinOpeningHours(start, end) : bool
  - estimatePrice(car, start, end) : float
}

class AuthService <<control>> {
  + create_user(name, email, password) : Token
  + authenticate_user(email, password) : Token
  + get_current_user(token) : User
  + require_admin(token) : User
  - hash_password(password) : str
  - verify_password(password, hash) : bool
  - create_access_token(user) : JWT
}

class ReservationService <<control>> {
  + create_reservation(token, car_id, start, end, payment) : Reservation
  + is_car_available(car, start, end) : bool
  + get_reservations_for_user(token) : Reservation[]
  + get_reservations(token) : Reservation[]
  + confirm_reservation(token, id) : Reservation
  + cancel_reservation(token, id) : Reservation
  - calculate_price(car, start, end) : float
}

class FleetService <<control>> {
  + get_cars(filters) : Car[]
  + get_branches() : Branch[]
  + create_car(token, data) : Car
  + update_car(token, id, data) : Car
  + delete_car(token, id)
}

interface NotificationService {
  + send_confirmation(reservation, user) : bool
}
class EmailNotificationService {
  + send_confirmation(reservation, user) : bool
}
class LoggingNotificationService {
  + send_confirmation(reservation, user) : bool
}

class Database <<SQLite>> {
  + query(entity, conditions) : list
  + save(obj)
  + delete(obj)
}

class User <<entity>> {
  id : int
  name : str
  email : str
  password_hash : str
  role : CUSTOMER | ADMIN
}
class Reservation <<entity>> {
  id : int
  start_date : datetime
  end_date : datetime
  status : DRAFT | CONFIRMED | CANCELLED
  total_price : float
  payment_method : CASH | CARD
}
class Car <<entity>> {
  id : int
  brand : str
  model : str
  license_plate : str
  daily_price : float
  hourly_price : float
  category, transmission, fuel_type
}
class Branch <<entity>> {
  id : int
  name : str
  address : str
}

WebApp ..> AuthService : HTTP
WebApp ..> ReservationService : HTTP
WebApp ..> FleetService : HTTP

ReservationService -left-> AuthService : auth
FleetService -[norank]-> AuthService : auth
ReservationService -right-> NotificationService : on confirm
NotificationService <|.. EmailNotificationService
NotificationService <|.. LoggingNotificationService

AuthService --> Database
ReservationService --> Database
FleetService --> Database

AuthService ...> User : <<instantiate>>
ReservationService ...> Reservation : <<instantiate>>
FleetService ...> Car : <<instantiate>>

User "1" -right- "0..*" Reservation : creates >
Reservation "0..*" -right- "1" Car : for >
Car "0..*" -right- "1" Branch : located at >
@enduml
