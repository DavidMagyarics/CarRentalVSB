@startuml sequence-contact-support
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
hide footbox
title Sequence — Contact support (UC7)

actor Customer
box "Frontend (React)" #E3F2FD
  participant ":SupportWidget" as Widget
end box
participant "phone / mail app\n(customer's device)" as Device

Customer -> Widget : click the support button\n(bottom-right, any page)
Widget -> Widget : setOpen(true)
Widget --> Customer : contact panel — phone, e-mail,\noffice hours (OPENING_HOURS_LABEL)
note right of Widget
  Purely client-side —
  no call to the backend
end note

opt click the phone number or the e-mail
  Customer -> Widget : click "tel:+420800123456"\nor "mailto:podpora@carrentalvsb.cz"
  Widget -> Device : open the tel: / mailto: link
  Device --> Customer : native phone / mail app opens
end

Customer -> Widget : click "×"
Widget -> Widget : setOpen(false)
@enduml
