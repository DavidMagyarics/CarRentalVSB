@startuml sequence-contact-support
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — Contact support (UC7)
actor Customer
participant ":SupportWidget" as W
participant "phone / mail app\n(customer's device)" as Device

Customer -> W : open()
W --> Customer : phone, e-mail, office hours
note right of W
  Only in the browser —
  no call to the backend
end note

opt click the phone number or the e-mail
  Customer -> W : click tel: / mailto: link
  W -> Device : open the link
  Device --> Customer : phone / mail app opens
end

Customer -> W : close()
@enduml
