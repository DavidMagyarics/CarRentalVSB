@startuml activity-contact-support
skinparam backgroundColor white

|Customer|
start
:Click the support button\n(bottom-right, any page);

|System|
:Show contact panel\n(phone, e-mail, office hours)\n— in the browser, no backend call;

|Customer|
if (Click phone or e-mail?) then (yes)
  |System|
  :Open the native phone/mail app\n(tel: / mailto: link);
else (no)
endif

|Customer|
:Close the panel;
stop
@enduml
