@startuml sequence-manage-fleet
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — Manage fleet (UC9)
actor Admin
participant ":FleetService" as Fleet
participant "admin : User" as A
participant "newCar : Car" as N
participant "c : Car" as C

note over Fleet, A
  Every operation first checks admin.is_admin() —
  a non-admin gets 403.
end note

alt Add a car
  Admin -> Fleet : create_car(data)\n[POST /cars/]
  Fleet -> A : is_admin()
  A --> Fleet : true
  Fleet -> Fleet : get_branch(data.branch_id)
  note right of Fleet : b : Branch (404 if it does not exist)
  create N
  Fleet -> N : <<create>> (brand, model, plate,\nprices, category, ..., b)
  Fleet --> Admin : 201 Created newCar
else Edit a car
  Admin -> Fleet : update_car(id, data)\n[PUT /cars/{id}]
  Fleet -> A : is_admin()
  A --> Fleet : true
  Fleet -> Fleet : get_car(id)
  Fleet -> C : update(data)
  Fleet --> Admin : 200 OK c
else Delete a car
  Admin -> Fleet : delete_car(id)\n[DELETE /cars/{id}]
  Fleet -> A : is_admin()
  A --> Fleet : true
  Fleet -> Fleet : get_car(id)
  Fleet -> C : <<destroy>>
  destroy C
  note right of Fleet
    All reservations of the car
    are deleted together with it
  end note
  Fleet --> Admin : 204 No Content
end
@enduml
