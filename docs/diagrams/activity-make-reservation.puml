@startuml activity_make_reservation
title Activity — Make reservation (UC4)
|Customer|
start
:Select car;
:Open booking form;
:Enter pickup and return date/time;
|System|
:Check availability (UC4a) against CONFIRMED reservations;
if (available?) then (yes)
  :Compute total_price;
  :Create reservation (DRAFT) with payment method;
  stop
else (no)
  :Return 409 Conflict;
  stop
endif

note right
  Pricing: daily rate per 24h block; remaining hours at hourly rate.
end note

@enduml
@startuml activity-make-reservation
skinparam backgroundColor white

|Customer|
start
:Browse cars;
:Select a car;
:Click "Reserve";
:Enter pickup and return\ndate & time;

if (Within opening hours?\n(Mon-Fri, 08:00-20:00)) then (yes)
  |System|
  if (Car available for\nthe requested times?) then (yes)
    |Customer|
    :Choose payment method\n(Cash / Card);
    if (Card?) then (yes)
      :Fill mock card details\n(never sent to the server);
    else (no)
    endif
    :Submit reservation;

    |System|
    :Calculate total price\n(daily rate per full 24h block +\nhourly rate for the rest, capped\nat one more day's rate);
    :Create Reservation\n(status DRAFT, payment_method,\ntotal_price);
    :Prepare success result;
  else (no)
    :Prepare "slot already\ntaken" error (409);
  endif
else (no)
  :Prepare opening-hours\nerror;
endif

|Customer|
:See result\n(confirmation awaiting admin\napproval, or error message);
stop
@enduml
