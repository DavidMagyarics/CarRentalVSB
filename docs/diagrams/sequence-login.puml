@startuml sequence-login
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — Log in (UC2)
actor "User\n(Customer or Admin)" as User
participant ":AuthService" as Auth
participant "u : User" as U

User -> Auth : authenticate_user(email, password)\n[POST /auth/login]
Auth -> Auth : get_user_by_email(email)

alt no user with this e-mail
  Auth --> User : 401 "Nesprávný e-mail nebo heslo"
else user found
  Auth -> U : check_password(password)
  U --> Auth : true / false
  alt password matches
    Auth -> Auth : create_access_token(u)
    Auth --> User : 200 OK {token, u}\n(u.role decides which tabs are shown)
  else wrong password
    Auth --> User : 401 "Nesprávný e-mail nebo heslo"
  end
end
@enduml
