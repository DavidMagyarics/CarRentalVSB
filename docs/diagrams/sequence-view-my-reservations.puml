@startuml sequence-view-my-reservations
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — View my reservations (UC6)
actor Customer
boundary ":WebApp" as Web
control ":ReservationService" as Res
control ":AuthService" as Auth
database ":Database" as DB

Customer -> Web : showReservations()
Web -> Res : get_reservations_for_user(token)\n[GET /reservations/me]
Res -> Auth : get_current_user(token)

alt no token, or the token is invalid / expired
  Auth --> Res : 401
  Res --> Web : 401 Unauthorized
else valid token
  Auth --> Res : user : User
  Res -> DB : query(Reservation) where user = user,\nnewest first
  DB --> Res : Reservation[] (each with its car)
  Res --> Web : 200 OK Reservation[]
end

Web --> Customer : list — car, dates, price,\npayment method, status
@enduml
