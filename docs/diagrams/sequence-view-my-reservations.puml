@startuml sequence-view-my-reservations
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — View my reservations (UC6)
actor Customer
participant ":ReservationService" as Res
participant ":AuthService" as Auth
participant "u : User" as U

Customer -> Res : get_reservations_for_user()\n[GET /reservations/me + JWT]
Res -> Auth : get_current_user(token)

alt no token, or the token is invalid / expired
  Auth --> Res : error
  Res --> Customer : 401 Unauthorized
else valid token
  Auth --> Res : u
  Res -> U : get_reservations()
  U --> Res : Reservation[] (newest first)
  Res --> Customer : 200 OK Reservation[] — car,\ndates, price, payment, status
end
@enduml
