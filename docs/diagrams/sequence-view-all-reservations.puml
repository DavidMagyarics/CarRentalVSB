@startuml sequence-view-all-reservations
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — View all reservations (UC10)
actor Admin
participant ":ReservationService" as Res
participant "admin : User" as A
participant "r : Reservation" as R

Admin -> Res : get_reservations()\n[GET /reservations/]
Res -> A : is_admin()
A --> Res : true / false

alt not an admin
  Res --> Admin : 403 "Vyžadována jsou práva administrátora"
else admin
  loop for each reservation (newest first)
    Res -> R : get_car(), get_user()
    R --> Res : car, customer
  end
  Res --> Admin : 200 OK Reservation[] — car, customer,\ndates, price, payment, status
end

note over Admin, Res
  From this list the admin can confirm (UC8)
  or cancel (UC5) a reservation.
end note
@enduml
