@startuml sequence-view-all-reservations
skinparam backgroundColor white
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
title Sequence — View all reservations (UC10)
actor Admin
boundary ":WebApp" as Web
control ":ReservationService" as Res
control ":AuthService" as Auth
database ":Database" as DB

Admin -> Web : showReservations() — "Všechny rezervace"
Web -> Res : get_reservations(token)\n[GET /reservations/]
Res -> Auth : require_admin(token)

alt not an admin
  Auth --> Res : 403
  Res --> Web : 403 "Vyžadována jsou práva administrátora"
else admin
  Auth --> Res : admin : User
  Res -> DB : query(Reservation), newest first
  DB --> Res : Reservation[] (every customer,\nwith car and customer)
  Res --> Web : 200 OK Reservation[]
end

Web --> Admin : table — car, customer, dates, price,\npayment, status; buttons "Potvrdit" (UC8)\nand "Zrušit" (UC5)
@enduml
