# Copy to backend/.env and adjust. All values are optional.

# Database (SQLite by default; a PostgreSQL URL also works with the right driver installed)
DATABASE_URL=sqlite:///./carrental.db

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of origins allowed to call the API (the Vite SPA)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed demo admin/customer/branches/cars on first start
SEED_DEMO_DATA=true

# Optional SMTP (UC8a). When SMTP_HOST is empty, confirmations are only logged
# (LoggingNotificationService). When set, EmailNotificationService is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@carrental.local
SMTP_USE_TLS=true
